generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  Int                  @id @default(autoincrement())
  username            String               @unique
  fullName            String
  passwordHash        String
  role                String               @default("citizen")
  phoneNumber         String?
  email               String?
  ward                String?
  dateOfBirth         String?
  gender              String?
  idDocumentType      String?
  idNumber            String?
  disabilityStatus    String?
  residency           String?
  occupation          String?
  village             String?
  subLocation         String?
  physicalAddress     String?
  emergencyContact    String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  bursaryApplications BursaryApplication[]
  bursaryDocuments    BursaryDocument[]
  complaints          Complaint[]
  notifications       Notification[]

  @@index([role])
}

model Complaint {
  id          Int      @id @default(autoincrement())
  userId      Int?
  category    String
  priority    String   @default("Normal")
  description String
  village     String?
  status      String   @default("Pending")
  code        String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}

model BursaryApplication {
  id              Int      @id @default(autoincrement())
  userId          Int
  status          String   @default("Pending")
  applicationCode String   @unique
  submittedAt     DateTime @default(now())
  data            Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents       BursaryDocument[]

  @@index([userId])
  @@index([status])
}

model BursaryDocument {
  id            Int                @id @default(autoincrement())
  userId        Int
  applicationId Int?
  documentType  String
  fileName      String
  mimeType      String
  fileSize      Int
  fileData      Bytes
  createdAt     DateTime           @default(now())
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  application   BursaryApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([applicationId])
  @@index([documentType])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int?
  title     String?
  message   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model Announcement {
  id        Int      @id @default(autoincrement())
  title     String?
  message   String?
  createdAt DateTime @default(now())
}

model Project {
  id          Int      @id @default(autoincrement())
  title       String?
  description String?
  status      String?
  data        Json?
  createdAt   DateTime @default(now())
}

model Event {
  id          Int       @id @default(autoincrement())
  title       String?
  description String?
  eventDate   DateTime?
  location    String?
  data        Json?
  createdAt   DateTime  @default(now())
}

model app_state_snapshots {
  key        String   @id
  data       Json
  updated_at DateTime @default(now()) @db.Timestamptz(6)
}
