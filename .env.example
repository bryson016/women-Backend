# Copy to `.env` and fill in real values. NEVER commit `.env` (it is gitignored).
# Frontend uses EXPO_PUBLIC_API_URL (see root .env.example); backend uses the vars below.

# Server
PORT=5000
NODE_ENV=development

# Auth — REQUIRED in production: generate a long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-this-to-a-strong-secret-key-in-production
JWT_EXPIRES_IN=7d

# Password hashing cost (bcryptjs rounds; 10 is a good default)
BCRYPT_ROUNDS=10

# Optional dev/test admin seed. When BOTH are set, the server creates (or
# promotes) this admin account on startup. Leave unset in production unless
# you understand the implications. Never commit real values.
# ADMIN_SEED_USERNAME=
# ADMIN_SEED_PASSWORD=

# PostgreSQL connection used by database/persistence.js to make accounts and
# data survive restarts/redeploys. REQUIRED in production (e.g. a Render
# PostgreSQL instance) — without it the API runs in-memory only and every
# account is lost on restart (logins then fail with "Invalid credentials").
# Example: DATABASE_URL=postgresql://user:password@host:5432/dbname
# DATABASE_URL=

# Set to "true" to enable verbose auth diagnostics in production (safe: never
# logs passwords, hashes, tokens or secrets). Useful when debugging logins.
# DEBUG_AUTH=false
