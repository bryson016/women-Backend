# Copy to `.env` and fill in real values. NEVER commit `.env` (it is gitignored).
# Frontend uses EXPO_PUBLIC_API_URL (see root .env.example); backend uses the vars below.

# Server
PORT=5000
NODE_ENV=development

# Auth — REQUIRED in production: generate a long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-this-to-a-strong-secret-key-in-production
JWT_EXPIRES_IN=7d

# Password hashing cost (bcryptjs rounds; 10 is a good default)
BCRYPT_ROUNDS=10

# Optional dev/test admin seed. When BOTH are set, the server creates (or
# promotes) this admin account on startup. Leave unset in production unless
# you understand the implications. Never commit real values.
# ADMIN_SEED_USERNAME=
# ADMIN_SEED_PASSWORD=

# Reserved for the future PostgreSQL + Prisma migration (not used yet).
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=
# DB_NAME=ward_management
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/ward_management